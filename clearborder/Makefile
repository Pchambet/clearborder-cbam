# ClearBorder: run from this directory (clearborder/).
.PHONY: install test test-cov lint format example run-api run-dashboard up seed

install:
	pip install -r requirements-dev.txt

test:
	pytest -q

test-cov:
	pytest -q --cov=app --cov-report=term-missing

lint:
	ruff check .
	ruff format --check .

format:
	ruff check --fix .
	ruff format .

# Worked example in the README: table + figure, generated by the engine
example:
	python scripts/worked_example.py

run-api:
	uvicorn app.main:app --reload --host 127.0.0.1 --port 8000

run-dashboard:
	streamlit run dashboard/app.py --server.headless true

# Containers (PostgreSQL)
up:
	docker compose up

# Demo data, once after the first `docker compose up`
seed:
	docker compose run --rm api python scripts/seed_data.py
